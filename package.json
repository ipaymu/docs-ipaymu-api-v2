{
  "name": "docs-ipaymu-api-v2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node ./scripts/clean-staged.mjs && next build",
    "build:close-api-content": "node ./scripts/build-close-api-content.mjs",
    "build:pages": "bun ./scripts/build-pages.mjs",
    "dev": "next dev",
    "preview:pages": "bun ./scripts/preview-pages.mjs",
    "start": "serve out",
    "prepare": "tw-patch install",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.26.0",
    "mermaid": "^11.16.1",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.22",
    "serve": "^14.2.6",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-patch": "^10.0.2",
    "typescript": "^5.7.3",
    "unplugin-tailwindcss-mangle": "^6.0.1"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.0",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.5",
    "brace-expansion": "^1.1.18",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.17"
  },
  "resolutions": {
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.5",
    "brace-expansion": "^1.1.18",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.17"
  }
}
