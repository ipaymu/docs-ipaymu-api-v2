{
  "name": "docs-ipaymu-api-v2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node ./scripts/clean-staged.mjs && next build",
    "build:private": "node ./scripts/with-close-api.mjs build",
    "build:pages": "bun ./scripts/build-pages.mjs",
    "dev": "next dev",
    "dev:private": "node ./scripts/with-close-api.mjs dev",
    "preview:pages": "bun ./scripts/preview-pages.mjs",
    "start": "serve out",
    "prepare": "tw-patch install",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.26.0",
    "mermaid": "^11.16.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-mermaid-dataurl": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.22",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-patch": "^10.0.2",
    "typescript": "^5.7.3",
    "unplugin-tailwindcss-mangle": "^6.0.1"
  }
}
